    ]
  },
  "schemaVersion": 39,
  "timezone": "browser",
  "title": "Metrics - Nginx",
  "uid": "metrics-nginx-dashboard",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage per Container",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"/?nginx\"}[1m])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic",
            "scheme": "Blues"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage per Container",
      "gridPos": {
        "h": 8,
